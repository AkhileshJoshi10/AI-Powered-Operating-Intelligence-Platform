        "subject": "={{ '[DAILY EXECUTIVE BRIEF] SmartMart - ' + ($json.brief?.brief_date || 'Current') }}",
        "emailFormat": "text",
        "text": "={{\n(() => {\n    const b = $json.brief || {};\n    const d = b.brief_data || {};\n    const issues = d.issue_snapshot || {};\n    const recs = d.recommendation_snapshot || {};\n    const tasks = d.task_snapshot || {};\n    const autos = d.automation_snapshot || {};\n    const attention = Array.isArray(d.management_attention)\n        ? d.management_attention\n        : [];\n\n    return (\n        'AI CHIEF OF STAFF — DAILY EXECUTIVE BRIEF\\n\\n'\n        + 'Date: ' + (b.brief_date || 'N/A') + '\\n\\n'\n\n        + 'EXECUTIVE SUMMARY\\n'\n        + (b.summary_text || 'No summary available.')\n        + '\\n\\n'\n\n        + 'MANAGEMENT ATTENTION\\n'\n        + (\n            attention.length\n                ? attention.map(x => '- ' + x).join('\\n')\n                : '- No immediate management action.'\n        )\n        + '\\n\\n'\n\n        + 'BUSINESS WORKFLOW SNAPSHOT\\n'\n        + 'Open issues: '\n        + (issues.open_issue_count ?? 0)\n        + '\\n'\n\n        + 'High-priority open issues: '\n        + (issues.high_priority_open_issue_count ?? 0)\n        + '\\n'\n\n        + 'Recommendations needing review: '\n        + (recs.recommendations_needing_review ?? 0)\n        + '\\n'\n\n        + 'Active tasks: '\n        + (tasks.active_task_count ?? 0)\n        + '\\n'\n\n        + 'Blocked tasks: '\n        + (tasks.blocked_task_count ?? 0)\n        + '\\n'\n\n        + 'Overdue tasks: '\n        + (tasks.overdue_task_count ?? 0)\n        + '\\n\\n'\n\n        + 'AUTOMATION SNAPSHOT\\n'\n        + 'Successful today: '\n        + (autos.successful_workflow_count ?? 0)\n        + '\\n'\n\n        + 'Failed today: '\n        + (autos.failed_workflow_count ?? 0)\n        + '\\n'\n\n        + 'In progress today: '\n        + (autos.in_progress_workflow_count ?? 0)\n        + '\\n'\n\n        + 'Last brief delivery status: '\n        + (\n            autos.last_executive_brief_delivery_status\n            || 'No previous delivery recorded'\n        )\n        + '\\n\\n'\n\n        + 'Generated by the AI-Powered Operating Intelligence Platform.'\n    );\n})()\n}}",
        "options": {
          "appendAttribution": false
