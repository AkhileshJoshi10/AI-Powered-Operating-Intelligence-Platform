# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_operating_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Application
APP_NAME=AI-Powered Operating Intelligence Platform API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Provider-independent LLM foundation
# Keep false until the Groq live smoke test succeeds.
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1
LLM_DEFAULT_AGENT_VERSION=1.0.0
LLM_DEFAULT_PROMPT_VERSION=v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ESTIMATED_COST_USD=0.02
LLM_TEMPERATURE=0.0
LLM_MASK_SENSITIVE_DATA=true
# Comma-separated tool names.
# Keep blank until the controlled MCP/tool-use stage.
LLM_ALLOWED_TOOLS=

# Groq provider

# Keep the real API key only in the local .env file.
# Never put a real key in this example file.
GROQ_API_KEY=

# Enable these values only after the Groq smoke test passes:
#
# LLM_ENABLED=true
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b


# ============================================================
# Knowledge ingestion and retrieval
# ============================================================

KNOWLEDGE_ENABLED=true

KNOWLEDGE_MAX_FILE_BYTES=5000000

KNOWLEDGE_CHUNK_SIZE_CHARS=1800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=500

KNOWLEDGE_DEFAULT_SEARCH_LIMIT=5
KNOWLEDGE_MAX_SEARCH_LIMIT=20

# Comma-separated extensions.
KNOWLEDGE_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json