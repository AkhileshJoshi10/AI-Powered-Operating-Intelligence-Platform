POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_operating_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Application
APP_NAME=AI-Powered Operating Intelligence Platform API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Provider-independent LLM foundation
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1
LLM_DEFAULT_AGENT_VERSION=1.0.0
LLM_DEFAULT_PROMPT_VERSION=v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ESTIMATED_COST_USD=0.02
LLM_TEMPERATURE=0.0
LLM_MASK_SENSITIVE_DATA=true
LLM_ALLOWED_TOOLS=