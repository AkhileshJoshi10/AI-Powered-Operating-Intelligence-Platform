# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_operating_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Application
APP_NAME=AI-Powered Operating Intelligence Platform API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Provider-independent LLM foundation
# Keep false unless live LLM enhancement is intentionally enabled.
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1
LLM_DEFAULT_AGENT_VERSION=1.0.0
LLM_DEFAULT_PROMPT_VERSION=v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_ESTIMATED_COST_USD=0.02
LLM_TEMPERATURE=0.0
LLM_MASK_SENSITIVE_DATA=true
# Comma-separated tool names.
# Keep blank unless controlled tools are intentionally enabled.
LLM_ALLOWED_TOOLS=

# Groq provider
GROQ_API_KEY=your_groq_api_key_here

# Enable these values only after the Groq smoke test passes:
#
# LLM_ENABLED=true
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b


# ============================================================
# Knowledge ingestion and retrieval
# ============================================================

KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_FILE_BYTES=5000000
KNOWLEDGE_CHUNK_SIZE_CHARS=1800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=500
KNOWLEDGE_DEFAULT_SEARCH_LIMIT=5
KNOWLEDGE_MAX_SEARCH_LIMIT=20

# Comma-separated extensions.
KNOWLEDGE_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json

# ============================================================
# Controlled agent tools
# ============================================================

# All controlled tool capabilities remain opt-in.
AGENT_TOOLS_ENABLED=false
AGENT_WRITE_TOOLS_ENABLED=false
AGENT_TOOL_TIMEOUT_SECONDS=5

# Arbitrary read-only SQL has its own independent gate.
AGENT_READ_ONLY_SQL_ENABLED=false
AGENT_READ_ONLY_SQL_STATEMENT_TIMEOUT_MS=2000
AGENT_READ_ONLY_SQL_MAX_ROWS=20

# Recommendation-to-task conversion requires its own gate in addition
# to the general write-tool and per-call approval controls.
AGENT_TASK_CONVERSION_TOOL_ENABLED=false

AGENT_LLM_TOOL_MAX_ROUNDS=2
AGENT_LLM_TOOL_RESULT_MAX_CHARS=20000


# ============================================================
# Automation / n8n
# ============================================================

# Keep false until the n8n workflows and credentials are configured.
AUTOMATION_ENABLED=false

# Protect the FastAPI workflow-trigger endpoints. Real value only in .env.
AUTOMATION_API_SECRET=

# Example local n8n webhook root. Leave blank until n8n is configured.
N8N_WEBHOOK_BASE_URL=

# Use different secrets for outbound webhook authentication and the
# protected callback endpoint. Real values belong only in local .env.
N8N_OUTBOUND_AUTH_TOKEN=
N8N_CALLBACK_SECRET=

N8N_TIMEOUT_SECONDS=10
N8N_MAX_RETRIES=2
N8N_RETRY_BACKOFF_SECONDS=0.5

# Fixed relative paths only. Do not place full external URLs here.
N8N_HIGH_PRIORITY_ALERT_PATH=high-priority-alert
N8N_TASK_REMINDER_PATH=task-reminder
N8N_OVERDUE_ESCALATION_PATH=overdue-escalation
